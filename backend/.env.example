# Copy to .env: cp .env.example .env
# Never commit .env (secrets / connection strings live only locally and in the hoster env).

NODE_ENV=development

# --- PostgreSQL (Neon, RDS, or any remote host) ---------------------------
# Pooled (recommended for serverless / many short-lived connections, e.g. Neon "Pooled" in dashboard):
#   postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Direct (migrations & long sessions — Neon often offers a "Direct" connection; use for prisma migrate if pooled fails):
#   postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Always use ?sslmode=require (or stricter) for public networks.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# --- CORS: origin of the Vite app (dev or deployed SPA URL) ---------------
FRONTEND_URL=http://localhost:5173

# API port (default 3000)
# PORT=3000

# Log level: trace | debug | info | warn | error
# LOG_LEVEL=info

# --- Clerk ----------------------------------------------------------------
# Secret key from Clerk dashboard (Backend). Required for protected routes
# and webhook user sync. Frontend uses VITE_CLERK_PUBLISHABLE_KEY (separate).
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Optional: only needed if you want to look up users / call Clerk Admin API.
# CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Svix signing secret from Clerk → Webhooks. Set when creating an endpoint.
# Either name is read by @clerk/express verifyWebhook; we pass it explicitly
# from CLERK_WEBHOOK_SECRET in code.
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- Cloudflare R2 (S3) — optional for local smoke -----------------------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=

# --- Swagger: serve OpenAPI UI (default: on in non-production) ------------
# ENABLE_API_DOCS=true
