# Copy to .env: cp .env.example .env
# Vite exposes only variables prefixed with VITE_ to the browser.

# Clerk (publishable key — safe in client bundle)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Cloudinary (cloud name only — matches backend CLOUDINARY_CLOUD_NAME)
VITE_CLOUDINARY_CLOUD_NAME=

# Backend API (use full origin; no trailing slash)
# Local Express default: http://localhost:3000
# Leave empty when the API is on the same host as the built SPA (Express static + /api).
VITE_API_URL=http://localhost:3000
