{
  "name": "react-express-map-pins",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm --filter frontend run build && pnpm --filter backend run build",
    "start": "pnpm --filter backend start",
    "lint": "eslint .",
    "test": "pnpm --filter backend --filter frontend run test",
    "test:e2e": "pnpm --filter e2e run test",
    "test:e2e:ui": "pnpm --filter e2e run test:ui"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
